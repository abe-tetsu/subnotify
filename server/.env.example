# YouTube OAuth credentials (required)
SUBNOTIFY_YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SUBNOTIFY_YOUTUBE_CLIENT_SECRET=your-client-secret

# Optional overrides
# SUBNOTIFY_DATA_DIR=.subnotify-data
# SUBNOTIFY_API_LISTEN_ADDR=:8080
# SUBNOTIFY_PUBLIC_BASE_URL=http://localhost:8080
